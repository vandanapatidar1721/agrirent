# =============================================================================
# AgriRent backend — copy this file to .env and fill in real values.
# Never commit .env to Git.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Local:
MONGO_URI=mongodb://localhost:27017/agrirent
# Production (MongoDB Atlas example):
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/agrirent?retryWrites=true&w=majority

# --- Auth (required) ---
# Generate for production: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret

# --- CORS (required for live frontend) ---
# Comma-separated URLs where your site is hosted (no trailing slash)
# Examples: https://your-app.netlify.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# --- API request logging ---
# true  = print each API call in the terminal (good for development)
# false = no API logs (recommended for production)
ENABLE_API_LOGGING=true

# --- Demo product seed ---
# true  = insert 8 demo products when the products collection is empty
# false = no auto-seed (recommended for production)
ENABLE_SEED=true

# =============================================================================
# Frontend (separate file): frontend/js/config.js
# Set API_BASE_URL to your live API, e.g. https://api.yourdomain.com
# See frontend/js/config.example.js
# =============================================================================
